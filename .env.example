# ============================================================
# VoiceBridge 运行配置模板
# 使用方法：cp .env.example .env，然后填入真实值
# .env 含密钥，已在 .gitignore 中排除，不会被提交
# ============================================================

# ---- 语音引擎（OpenAI 兼容：grok-stt + grok-voice）----
VOICE_API_BASE_URL=https://your-voice-gateway.example/v1
VOICE_API_KEY=your_api_key_here
STT_MODEL=grok-stt
STT_LANGUAGE=zh
TTS_MODEL=grok-voice-think-fast-2.0
TTS_VOICE=alloy
TTS_LANGUAGE=zh

# ---- 大模型（OpenAI 兼容 /chat/completions）----
# 留空 LLM_KEY 时对话返回本地演示回复
LLM_BASE_URL=https://your-voice-gateway.example/v1
LLM_KEY=
LLM_MODEL=grok-chat-fast

# ---- 实时通话（复用语音引擎的 BASE_URL/KEY）----
REALTIME_MODEL=grok-voice-think-fast-2.0
REALTIME_IN_RATE=48000    # 浏览器麦克风原始采样率
REALTIME_OUT_RATE=24000   # 上游返回 PCM 的采样率

# ---- 限制（可选，留空走后端默认）----
MAX_UPLOAD_MB=20
MAX_RECORD_SECONDS=60
MAX_TTS_CHARS=500
